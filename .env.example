SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Analytics / Site QA (/admin/site-qa) — all OPTIONAL ──────────────────────
# Everything below fails GRACEFULLY when unset: PostHog simply doesn't load,
# and the Site QA cockpit shows "unavailable" for the missing integration.

# PostHog (product analytics — page views, funnels, replays). The PROJECT key is
# browser-safe (write-only); it is the ONLY analytics value exposed client-side.
VITE_PUBLIC_POSTHOG_KEY=""
VITE_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# PostHog read API (server-only) — powers the Site QA "Traffic" tab. The personal
# API key is a SECRET; never give it a VITE_ prefix.
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID=""
POSTHOG_API_HOST="https://us.posthog.com"

# Sentry browser SDK (error capture). Browser-safe by design (a DSN is meant to
# be public). Without it the SDK never loads and no errors are captured.
VITE_PUBLIC_SENTRY_DSN=""

# RETARGETING TAGS (lib/retargeting.ts). Browser-safe IDs — each tag loads ONLY when its ID is set,
# only on public pages, never on an admin device / test session / Global Privacy Control. A value
# in the wrong shape is refused (console warning), never loaded. Redeploy after setting them.
VITE_PUBLIC_GOOGLE_ADS_ID=""       # AW-123456789   (Google Ads → Tools → Google tag) — YouTube retargeting
VITE_PUBLIC_GA4_ID=""              # G-XXXXXXXXXX   (optional GA4 property, same gtag.js)
VITE_PUBLIC_META_PIXEL_ID=""       # 1234567890123456 (Meta Events Manager → Data sources)
VITE_PUBLIC_TIKTOK_PIXEL_ID=""     # CXXXXXXXXXXXXXXXXXXX (TikTok Ads Manager → Assets → Events)

# Sentry read API (server-only) — powers the Site QA error badges. Optional.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# SENTRY_HOST="https://sentry.io"   # only for self-hosted Sentry

# Vercel read API (server-only) — powers the "Latest deploy" chip. Optional; the
# deployed commit sha is already available from VERCEL_GIT_COMMIT_SHA at build.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
# VERCEL_TEAM_ID=""                  # only if the project lives under a team

# Recraft — the illustration provider for the /v3 Shorts slides (server-only; never VITE_).
# Without it the editor still loads; the Generate button says generation is unavailable.
RECRAFT_API_KEY=""
# Optional: a Recraft custom style id once a house style is locked from approved images
# (POST /v1/styles). Present = generations use recraftv4_styles + style_match: precise.
# RECRAFT_STYLE_ID_WATERCOLOR=""     # Survive Watercolor (2026-09-05), the current default
# RECRAFT_STYLE_ID_DREAMSTATE=""     # the earlier monoline-on-black look — kept for old assets
