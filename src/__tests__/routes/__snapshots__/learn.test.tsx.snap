// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`/learn home (simplified) desktop structure snapshot 1`] = `"<div class="min-h-0 flex-1 overflow-y-auto" style="scrollbar-width:thin"><h1 class="lk-disp" style="padding:18px 32px 8px;font-size:28px;line-height:1.15;letter-spacing:-0.015em;color:var(--text-primary, #F7F0E6)">Free ACCY 201 prep at Ole Miss</h1><div class="flex flex-col" style="gap:34px;padding:10px 0 40px"><section style="padding:0 32px" class="flex flex-col gap-3"><div class="flex items-baseline gap-3"><span class="lk-disp" style="font-size:19px;color:var(--text-primary, #F7F0E6)">Cram</span><span class="lk-body truncate text-[13px]" style="color:var(--text-secondary, #AAB4C8)">Easy Points</span></div><div class="lk-scroll-x" style="gap:12px"><button type="button" class="lk-short" data-on="false" style="width:152px;height:270px;opacity:1" title="Internal vs. external users"><img src="https://image.mux.com/pb1/thumbnail.jpg?width=320&amp;time=2" alt="" loading="lazy"/><span class="lk-short-d">1:42</span><span class="absolute left-2 top-2 z-[1] grid h-6 w-6 place-items-center rounded-full" style="background:#3BF5A0;color:#0B1220"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-3.5 w-3.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="lk-short-t" style="z-index:1">Internal vs. external users</span></button><button type="button" class="lk-short" data-on="false" style="width:152px;height:270px;opacity:1" title="Financial vs. managerial accounting"><span class="absolute inset-x-2 top-1/2 -translate-y-1/2 text-center text-[11px] font-semibold" style="color:rgba(170,180,200,0.55)">Cram video coming soon</span><span class="lk-short-t" style="z-index:1">Financial vs. managerial accounting</span></button></div></section><section style="padding:0 32px" class="flex flex-col gap-3"><div class="flex items-baseline gap-3"><span class="lk-disp" style="font-size:19px;color:var(--text-primary, #F7F0E6)">Cram</span><span class="lk-body truncate text-[13px]" style="color:var(--text-secondary, #AAB4C8)">Analyzing Transactions</span></div><div class="lk-scroll-x" style="gap:12px"><button type="button" class="lk-short" data-on="false" style="width:152px;height:270px;opacity:1" title="Account classification"><img src="https://image.mux.com/pb3/thumbnail.jpg?width=320&amp;time=2" alt="" loading="lazy"/><span class="lk-short-d">1:29</span><span class="absolute inset-x-0 bottom-0 z-[1] h-[3px]" style="background:rgba(255,255,255,0.2)"><span class="block h-full" style="width:40%;background:var(--lk-acc)"></span></span><span class="lk-short-t" style="z-index:1">Account classification</span></button></div></section><section style="padding:0 32px" class="flex flex-col gap-3"><div class="flex items-baseline gap-3"><span class="lk-disp" style="font-size:19px;color:var(--text-primary, #F7F0E6)">Practice</span></div><div class="lk-scroll-x" style="gap:12px"><button type="button" class="lk-card lk-body flex shrink-0 flex-col gap-2 p-3.5 text-left" style="width:290px;color:var(--text-primary, #F7F0E6);cursor:pointer"><div class="flex items-center gap-2 text-[13.5px] font-bold"><span class="min-w-0 flex-1 truncate">Internal vs. external users</span></div><div class="text-[12px]" style="color:var(--text-secondary, #AAB4C8)">8 questions</div><div class="line-clamp-2 text-[12.5px] leading-relaxed" style="color:var(--text-secondary, #AAB4C8)">Which of the following is a user of financial accounting information?</div></button><button type="button" class="lk-card lk-body flex shrink-0 flex-col gap-2 p-3.5 text-left" style="width:290px;color:var(--text-primary, #F7F0E6);cursor:pointer"><div class="flex items-center gap-2 text-[13.5px] font-bold"><span class="min-w-0 flex-1 truncate">Financial vs. managerial accounting</span></div><div class="text-[12px]" style="color:var(--text-secondary, #AAB4C8)">8 questions</div></button></div></section><div class="lk-body text-[12.5px]" style="padding:0 32px;color:var(--text-secondary, #AAB4C8)">Have an account? <button type="button" class="underline underline-offset-2" style="background:transparent;border:0;color:inherit;cursor:pointer;font:inherit">Sign in</button></div></div></div>"`;

exports[`/learn home (simplified) phone structure snapshot 1`] = `"<div class="min-h-0 flex-1 overflow-y-auto" style="scrollbar-width:thin"><h1 class="lk-disp" style="padding:14px 16px 6px;font-size:22px;line-height:1.15;letter-spacing:-0.015em;color:var(--text-primary, #F7F0E6)">Free ACCY 201 prep at Ole Miss</h1><div class="flex flex-col" style="gap:26px;padding:10px 0 40px"><section style="padding:0 16px" class="flex flex-col gap-3"><div class="flex items-baseline gap-3"><span class="lk-disp" style="font-size:19px;color:var(--text-primary, #F7F0E6)">Cram</span><span class="lk-body truncate text-[13px]" style="color:var(--text-secondary, #AAB4C8)">Easy Points</span></div><div class="lk-scroll-x" style="gap:8px"><button type="button" class="lk-short" data-on="false" style="width:118px;height:210px;opacity:1" title="Internal vs. external users"><img src="https://image.mux.com/pb1/thumbnail.jpg?width=320&amp;time=2" alt="" loading="lazy"/><span class="lk-short-d">1:42</span><span class="absolute left-2 top-2 z-[1] grid h-6 w-6 place-items-center rounded-full" style="background:#3BF5A0;color:#0B1220"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-3.5 w-3.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="lk-short-t" style="z-index:1">Internal vs. external users</span></button><button type="button" class="lk-short" data-on="false" style="width:118px;height:210px;opacity:1" title="Financial vs. managerial accounting"><span class="absolute inset-x-2 top-1/2 -translate-y-1/2 text-center text-[11px] font-semibold" style="color:rgba(170,180,200,0.55)">Cram video coming soon</span><span class="lk-short-t" style="z-index:1">Financial vs. managerial accounting</span></button></div></section><section style="padding:0 16px" class="flex flex-col gap-3"><div class="flex items-baseline gap-3"><span class="lk-disp" style="font-size:19px;color:var(--text-primary, #F7F0E6)">Cram</span><span class="lk-body truncate text-[13px]" style="color:var(--text-secondary, #AAB4C8)">Analyzing Transactions</span></div><div class="lk-scroll-x" style="gap:8px"><button type="button" class="lk-short" data-on="false" style="width:118px;height:210px;opacity:1" title="Account classification"><img src="https://image.mux.com/pb3/thumbnail.jpg?width=320&amp;time=2" alt="" loading="lazy"/><span class="lk-short-d">1:29</span><span class="absolute inset-x-0 bottom-0 z-[1] h-[3px]" style="background:rgba(255,255,255,0.2)"><span class="block h-full" style="width:40%;background:var(--lk-acc)"></span></span><span class="lk-short-t" style="z-index:1">Account classification</span></button></div></section><section style="padding:0 16px" class="flex flex-col gap-3"><div class="flex items-baseline gap-3"><span class="lk-disp" style="font-size:19px;color:var(--text-primary, #F7F0E6)">Practice</span></div><div class="lk-scroll-x" style="gap:8px"><button type="button" class="lk-card lk-body flex shrink-0 flex-col gap-2 p-3.5 text-left" style="width:230px;color:var(--text-primary, #F7F0E6);cursor:pointer"><div class="flex items-center gap-2 text-[13.5px] font-bold"><span class="min-w-0 flex-1 truncate">Internal vs. external users</span></div><div class="text-[12px]" style="color:var(--text-secondary, #AAB4C8)">8 questions</div><div class="line-clamp-2 text-[12.5px] leading-relaxed" style="color:var(--text-secondary, #AAB4C8)">Which of the following is a user of financial accounting information?</div></button><button type="button" class="lk-card lk-body flex shrink-0 flex-col gap-2 p-3.5 text-left" style="width:230px;color:var(--text-primary, #F7F0E6);cursor:pointer"><div class="flex items-center gap-2 text-[13.5px] font-bold"><span class="min-w-0 flex-1 truncate">Financial vs. managerial accounting</span></div><div class="text-[12px]" style="color:var(--text-secondary, #AAB4C8)">8 questions</div></button></div></section><div class="lk-body text-[12.5px]" style="padding:0 16px;color:var(--text-secondary, #AAB4C8)">Have an account? <button type="button" class="underline underline-offset-2" style="background:transparent;border:0;color:inherit;cursor:pointer;font:inherit">Sign in</button></div></div></div>"`;
